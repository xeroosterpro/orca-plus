+import dagger.hilt.android.EntryPointAccessors
+
+/*
+ * Orca+: the first-run welcome. The screens live in the addon (welcome/); this file connects them
+ * to Wholphin's own server and sign-in logic, so adding a server and signing in work exactly as
+ * in Wholphin. The first run gets the whole welcome; signing in again later (the sign-in ran out,
+ * or "Change server") gets the same look: saved servers, then the sign-in.
+ */
+
+@Composable
+private fun orcaHook(): SourceHook {
+    val context = LocalContext.current
+    return remember { EntryPointAccessors.fromApplication(context.applicationContext, SourcesEntryPoint::class.java).sourceHook() }
+}
+
+/** In place of Wholphin's server list: the welcome on a true first run, else Wholphin's list. */
+@Composable
+fun OrcaServerList(modifier: Modifier = Modifier) {
+    val hook = orcaHook()
+    val stage by hook.store.onboarding.collectAsState()
+    val viewModel: SwitchServerViewModel = hiltViewModel()
+    val state by viewModel.state.collectAsState()
+    LaunchedEffect(Unit) { viewModel.init() }
+
+    val firstRun = stage == Onboarding.STARTED || (stage == Onboarding.NEW && state.loading is LoadingState.Success && state.servers.isEmpty())
+    // Signing in again: "Add a server" opens the welcome's server step
+    var adding by rememberSaveable { mutableStateOf(false) }
+    when {
+        firstRun || adding -> {
+            LaunchedEffect(Unit) { if (hook.store.onboarding.value == Onboarding.NEW) hook.store.setOnboarding(Onboarding.STARTED) }
+            val permission =
+                rememberLauncherForActivityResult(ActivityResultContracts.RequestPermission()) { granted ->
+                    if (granted) viewModel.discoverServers()
+                }
+            LaunchedEffect(Unit) {
+                viewModel.clearAddServerState()
+                if (viewModel.hasPermission) {
+                    viewModel.discoverServers()
+                } else if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.CINNAMON_BUN) {
+                    permission.launch(Manifest.permission.ACCESS_LOCAL_NETWORK)
+                }
+            }
+            val found = state.discoveredServers.map { FoundServer(it.id.toString(), it.name.orEmpty(), it.url) }
+            WelcomeServerFlow(
+                found = found,
+                connecting = state.addServerState is LoadingState.Loading,
+                error = (state.addServerState as? LoadingState.Error)?.localizedMessage,
+                onPick = { picked -> state.discoveredServers.firstOrNull { it.id.toString() == picked.key }?.let(viewModel::switchServer) },
+                onAddress = { viewModel.addServer(it, false) },
+                onSearchAgain = { viewModel.discoverServers() },
+                modifier = modifier,
+            )
+            if (adding) androidx.activity.compose.BackHandler { adding = false }
+        }
+        // Still finding out whether servers are saved: a dark stage, not a flash of the old list
+        stage == Onboarding.NEW && state.loading !is LoadingState.Success && state.loading !is LoadingState.Error ->
+            Box(modifier.fillMaxSize().background(Color(0xFF0B0B0B)))
+        else ->
+            WelcomeServerChoice(
+                servers =
+                    state.servers.map {
+                        SavedServer(
+                            key = it.server.id.toString(),
+                            name = it.server.name.orEmpty(),
+                            address = it.server.url,
+                            reachable =
+                                when (it.status) {
+                                    is ServerConnectionStatus.Success -> true
+                                    is ServerConnectionStatus.Error -> false
+                                    else -> null
+                                },
+                        )
+                    },
+                onPick = { picked ->
+                    state.servers.firstOrNull { it.server.id.toString() == picked.key }?.let {
+                        if (it.status is ServerConnectionStatus.Success) viewModel.switchServer(it.server) else viewModel.testServer(it.server)
+                    }
+                },
+                onAdd = { adding = true },
+                modifier = modifier,
+            )
+    }
+}
+
+/** In place of Wholphin's user list: the welcome's sign-in during the first run. */
+@Composable
+fun OrcaUserList(
+    server: JellyfinServer,
+    modifier: Modifier = Modifier,
+) {
+    val hook = orcaHook()
+    val stage by hook.store.onboarding.collectAsState()
+    val viewModel = hiltViewModel<SwitchUserViewModel, SwitchUserViewModel.Factory>(creationCallback = { it.create(server) })
+    val state by viewModel.state.collectAsState()
+    // Users with a Wholphin PIN on this TV keep Wholphin's own screen (it asks for the PIN)
+    if (stage != Onboarding.STARTED && state.users.any { it.known && it.user.pin != null }) {
+        SwitchUserContent(server = server, modifier)
+        return
+    }
+    val scope = rememberCoroutineScope()
+    var submitted by remember { mutableStateOf(false) }
+    var switchError by remember { mutableStateOf<String?>(null) }
+    LaunchedEffect(Unit) { viewModel.init() }
+    val error = switchError ?: (state.switchUserState as? LoadingState.Error)?.localizedMessage
+    LaunchedEffect(error) { if (error != null) submitted = false }
+    WelcomeSignIn(
+        eyebrow = if (stage == Onboarding.STARTED) "SIGN IN  ·  2 OF 2" else "SIGN IN",
+        // Someone already signed in on this TV switches straight in; if that sign-in has run
+        // out, the password box is waiting
+        onPickUser = { name ->
+            switchError = null
+            state.users.firstOrNull { it.known && it.user.name == name && it.user.accessToken != null }?.let { u ->
+                scope.launch {
+                    val r = viewModel.trySwitchUser(u.user).await()
+                    if (r is SwitchUserResult.Error) switchError = r.errorMessage
+                }
+            }
+        },
+        serverName = server.name.orEmpty(),
+        quickEnabled = state.quickConnectEnabled,
+        quickCode = state.quickConnectStatus?.code,
+        users = state.users.map { WelcomeUser(it.user.name.orEmpty(), it.imageUrl) }.filter { it.name.isNotBlank() },
+        busy = submitted,
+        error = error,
+        onQuickConnect = { viewModel.initiateQuickConnect(server, null) },
+        onPassword = { user, password ->
+            switchError = null
+            submitted = true
+            viewModel.clearSwitchUserState()
+            viewModel.login(server, null, user, password)
+        },
+        onBack = {
+            viewModel.cancelQuickConnect()
+            viewModel.setupNavigationManager.navigateTo(SetupDestination.ServerList)
+        },
+        modifier = modifier,
+    )
+}
+
+/**
+ * True while the welcome's last steps (other libraries, the look) own the screen after sign-in.
+ * MainContent shows [OrcaWelcomeFinish] instead of the app until then.
+ */
+@Composable
+fun orcaWelcomeOwnsScreen(): Boolean {
+    val hook = orcaHook()
+    val stage by hook.store.onboarding.collectAsState()
+    LaunchedEffect(stage) { if (stage == Onboarding.STARTED) hook.store.setOnboarding(Onboarding.FINISHING) }
+    return stage == Onboarding.STARTED || stage == Onboarding.FINISHING
+}
+
+@Composable
+fun OrcaWelcomeFinish(modifier: Modifier = Modifier) {
+    WelcomeFinish(onDone = {}, modifier = modifier.fillMaxSize())
+}
