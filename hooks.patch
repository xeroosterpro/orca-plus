+        // Orca+: the saved server, user and token, opened without asking the server (offline start)
+        suspend fun restoreOffline(
+            serverId: UUID?,
+            userId: UUID?,
+        ): CurrentUser? {
+            val saved = withContext(ioDispatcher) { serverId?.let { serverDao.getServer(it) } } ?: return null
+            val user = saved.users.firstOrNull { it.id == userId } ?: return null
+            apiClient.update(baseUrl = saved.server.url, accessToken = user.accessToken)
+            val current = CurrentUser(saved.server, user)
+            withContext(WholphinDispatchers.Main) { _current.value = current }
+            return current
+        }
+
         suspend fun fetchLastUsedServer(serverId: UUID?): JellyfinServer? =
             withContext(ioDispatcher) {
                 serverId?.let { serverDao.getServer(serverId)?.server }
