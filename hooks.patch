+/**
+ * Settings as two panes: topics on the left; the focused topic's settings on the right. Moving
+ * through the topics previews each one; Right (or OK) goes into it, Back comes out to the topics.
+ */
+@OptIn(androidx.compose.ui.ExperimentalComposeUiApi::class)
+@Composable
+fun OrcaSettingsPage(
+    initialPreferences: AppPreferences,
+    modifier: Modifier = Modifier,
+) {
+    var section by rememberSaveable { mutableStateOf(OrcaSection.ACCOUNT) }
+    var focused by remember { mutableStateOf(OrcaSection.ACCOUNT) }
+    var inPane by remember { mutableStateOf(false) }
+    val railFocus = remember { OrcaSection.entries.associateWith { FocusRequester() } }
+    // Entering a topic (Right or OK from the list) lands on its first setting, not on whichever
+    // setting happens to sit level with the topic
+    // One per topic: while topics cross-fade both panes are composed, and a shared requester
+    // could hand focus to the one leaving (a topic with Orca+ items is entered on its first one)
+    val paneFocuses = remember { OrcaSection.entries.associateWith { FocusRequester() } }
+    val paneFocus = paneFocuses.getValue(section)
+    val currentPane by androidx.compose.runtime.rememberUpdatedState(paneFocus)
+    val scope = androidx.compose.runtime.rememberCoroutineScope()
+
+    // Follow the focused topic once it rests, so sweeping down the list doesn't rebuild every pane
+    LaunchedEffect(focused) {
+        if (focused != section) {
+            delay(140)
+            section = focused
+        }
+    }
+    LaunchedEffect(Unit) { runCatching { railFocus.getValue(section).requestFocus() } }
+
+    val backToRail = {
+        inPane = false
+        runCatching { railFocus.getValue(section).requestFocus() }
+        Unit
+    }
+    // Back inside a topic returns to the topic list (key route for Android 11, callback for 13+)
+    BackHandler(enabled = inPane) { backToRail() }
+
+    // Orca+'s look (2026-10-08 face lift): a darker topic panel, the stage beside it with a faint
+    // accent wash, the open topic's header, and topics that cross-fade instead of swapping
+    Row(modifier.fillMaxSize().background(com.wholphinplus.sources.ui.SettingsPageColor).background(com.wholphinplus.sources.ui.SettingsBackdrop)) {
+        Column(
+            Modifier.width(340.dp).fillMaxHeight().background(com.wholphinplus.sources.ui.SettingsRailColor.copy(alpha = 0.72f)).padding(start = 36.dp, end = 22.dp, top = 30.dp),
+            verticalArrangement = Arrangement.spacedBy(4.dp),
+        ) {
+            Row(verticalAlignment = androidx.compose.ui.Alignment.CenterVertically, modifier = Modifier.padding(start = 18.dp)) {
+                Text("ORCA", color = com.wholphinplus.sources.ui.SettingsInk, fontSize = 13.sp, fontWeight = FontWeight.Black, letterSpacing = 2.sp)
+                Text("+", color = com.wholphinplus.sources.ui.SettingsAccent, fontSize = 13.sp, fontWeight = FontWeight.Black)
+            }
+            Text(stringResource(R.string.settings), fontSize = 28.sp, fontWeight = FontWeight.ExtraBold, color = com.wholphinplus.sources.ui.SettingsInk, modifier = Modifier.padding(start = 18.dp))
+            Spacer(Modifier.height(14.dp))
+            // All eight topics fit on a 1080p TV without scrolling (Account first: who you are, then the rest)
+            LazyColumn(
+                // Left from a topic's settings comes back to that topic. It took the topic level
+                // with the setting, and the page switched to it (Extra servers -> Home & Look)
+                modifier =
+                    Modifier.focusProperties {
+                        onEnter = {
+                            if (requestedFocusDirection == androidx.compose.ui.focus.FocusDirection.Left) {
+                                runCatching { railFocus.getValue(section).requestFocus() }
+                            }
+                        }
+                    },
+                verticalArrangement = Arrangement.spacedBy(2.dp),
+            ) {
+                itemsIndexed(OrcaSection.entries) { _, s ->
+                    com.wholphinplus.sources.ui.SettingsRailItem(
+                        title = stringResource(s.title),
+                        hint = stringResource(s.hint),
+                        selected = s == section,
+                        modifier =
+                            Modifier.focusRequester(railFocus.getValue(s)).onFocusChanged {
+                                if (it.isFocused) {
+                                    focused = s
+                                    inPane = false
+                                }
+                            }.onPreviewKeyEvent { e ->
+                                // Right straight after Down (inside the 140 ms wait): this topic opens
+                                // now and is entered, not the one still shown (its pane was then
+                                // rebuilt under focus and focus was lost)
+                                if (e.key == Key.DirectionRight && s != section) {
+                                    if (e.type == KeyEventType.KeyDown) {
+                                        section = s
+                                        scope.launch {
+                                            for (i in 0 until 20) {
+                                                androidx.compose.runtime.withFrameNanos {}
+                                                if (runCatching { currentPane.requestFocus() }.getOrDefault(false)) break
+                                            }
+                                        }
+                                    }
+                                    true
+                                } else {
+                                    false
+                                }
+                            },
+                        onClick = {
+                            section = s
+                            focused = s
+                        },
+                    )
+                }
+            }
+        }
+        Box(
+            Modifier
+                .weight(1f)
+                .fillMaxHeight()
+                .focusProperties { enter = { paneFocus } }
+            .onFocusChanged { if (it.hasFocus) inPane = true }
+                .onPreviewKeyEvent { e ->
+                    if (inPane && (e.key == Key.Back || e.key == Key.Escape)) {
+                        if (e.type == KeyEventType.KeyUp) backToRail()
+                        true
+                    } else {
+                        false
+                    }
+                },
+        ) {
+            val cinema = com.wholphinplus.sources.cinema.cinemaModeOn()
+            // The next topic fades in a little from the right as the last one fades out
+            androidx.compose.animation.AnimatedContent(
+                targetState = section,
+                transitionSpec = {
+                    (
+                        androidx.compose.animation.fadeIn(androidx.compose.animation.core.tween(260, delayMillis = 60, easing = com.wholphinplus.sources.ui.SettingsFade)) +
+                            androidx.compose.animation.slideInHorizontally(androidx.compose.animation.core.tween(320, easing = com.wholphinplus.sources.ui.SettingsEase)) { it / 40 }
+                    ).togetherWith(androidx.compose.animation.fadeOut(androidx.compose.animation.core.tween(140, easing = com.wholphinplus.sources.ui.SettingsFade)))
+                },
+                label = "topic",
+            ) { shown ->
+                Column(Modifier.fillMaxSize()) {
+                    com.wholphinplus.sources.ui.SettingsPaneHeader(stringResource(shown.title), stringResource(shown.hint))
+                    PreferencesContent(
+                        initialPreferences,
+                        PreferenceScreenOption.BASIC,
+                        // Rows scrolling up fade out under the header instead of being cut off
+                        Modifier.fillMaxSize().padding(start = 16.dp, end = 40.dp).then(com.wholphinplus.sources.ui.SettingsListFade),
+                        groupsOverride = orcaGroups(shown, cinema),
+                        titleOverride = stringResource(shown.title),
+                        grabFocus = false,
+                        animateIn = false,
+                        orcaTopic = shown.name,
+                        orcaFocusRequester = paneFocuses.getValue(shown).takeIf { com.wholphinplus.sources.ui.OrcaTopics.has(shown.name) },
+                        entryFocusRequester = paneFocuses.getValue(shown).takeUnless { com.wholphinplus.sources.ui.OrcaTopics.has(shown.name) },
+                    )
+                }
+            }
+        }
+    }
+}
