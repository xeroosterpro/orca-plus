<?xml version="1.0" encoding="utf-8"?>
<!-- Orca+: see orca_backup_rules.xml (Android 12 and later read this one). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="wholphinplus_sources.xml" />
        <exclude domain="sharedpref" path="wholphinplus_cloud.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="wholphinplus_sources.xml" />
        <exclude domain="sharedpref" path="wholphinplus_cloud.xml" />
    </device-transfer>
</data-extraction-rules>
