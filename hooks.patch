+/**
+ * Orca+: Wholphin's settings, reorganised. Wholphin splits them over a "basic" list and an
+ * "advanced" screen with repeated headings (Interface and Playback appear in both) and hides
+ * some behind sub-screens. Here every setting sits in one topic, picked from a menu on the left
+ * like a TV's own settings. The settings themselves (dialogs, validation, player-specific
+ * options) are Wholphin's own, drawn by [PreferencesContent].
+ */
+enum class OrcaSection(
+    @param:StringRes val title: Int,
+    @param:StringRes val hint: Int,
+) {
+    PLAYBACK(R.string.orca_settings_playback, R.string.orca_settings_playback_hint),
+    NEXT_UP(R.string.orca_settings_next_up, R.string.orca_settings_next_up_hint),
+    QUALITY(R.string.orca_settings_quality, R.string.orca_settings_quality_hint),
+    PLAYER(R.string.orca_settings_player, R.string.orca_settings_player_hint),
+    APPEARANCE(R.string.orca_settings_appearance, R.string.orca_settings_appearance_hint),
+    PROFILE(R.string.orca_settings_profile, R.string.orca_settings_profile_hint),
+    SCREENSAVER(R.string.orca_settings_screensaver, R.string.orca_settings_screensaver_hint),
+    ORCA(R.string.orca_settings_orca, R.string.orca_settings_orca_hint),
+    ABOUT(R.string.orca_settings_about, R.string.orca_settings_about_hint),
+}
+
+private fun group(
+    @StringRes title: Int,
+    vararg prefs: AppPreference<AppPreferences, out Any?>,
+    conditional: List<ConditionalPreferences<AppPreferences>> = listOf(),
+) = PreferenceGroup(title, prefs.toList(), conditional)
+
+private val usesExoPlayer = { p: AppPreferences ->
+    p.playbackPreferences.playerBackend.let { it == PlayerBackend.EXO_PLAYER || it == PlayerBackend.PREFER_MPV }
+}
+
+/** Every setting, in the topic people would look for it under. */
+fun orcaGroups(section: OrcaSection): List<PreferenceGroup<AppPreferences>> =
+    when (section) {
+        OrcaSection.PLAYBACK ->
+            listOf(
+                group(
+                    R.string.orca_settings_controls,
+                    AppPreference.SkipForward,
+                    AppPreference.SkipBack,
+                    AppPreference.SkipBackOnResume,
+                    AppPreference.OneClickPause,
+                    AppPreference.DpadSeekModePref,
+                    AppPreference.ControllerTimeout,
+                ),
+                group(R.string.orca_settings_picture, AppPreference.GlobalContentScale, AppPreference.CinemaMode),
+            )
+
+        OrcaSection.NEXT_UP ->
+            listOf(
+                group(
+                    R.string.next_up,
+                    AppPreference.ShowNextUpTiming,
+                    AppPreference.AutoPlayNextUp,
+                    AppPreference.AutoPlayNextDelay,
+                    AppPreference.PassOutProtection,
+                ),
+                group(
+                    R.string.skip,
+                    AppPreference.SkipIntros,
+                    AppPreference.SkipOutros,
+                    AppPreference.SkipRecaps,
+                    AppPreference.SkipPreviews,
+                    AppPreference.SkipCommercials,
+                ),
+            )
+
+        OrcaSection.QUALITY ->
+            listOf(
+                group(
+                    R.string.orca_settings_streaming,
+                    AppPreference.MaxBitrate,
+                    AppPreference.ResolutionSwitching,
+                    AppPreference.RefreshRateSwitching,
+                ),
+                // These are the built-in player's; MPV and external players decide for themselves
+                group(
+                    R.string.orca_settings_audio_video,
+                    conditional = listOf(ConditionalPreferences(usesExoPlayer, listOf(AppPreference.Ac3Supported, AppPreference.DownMixStereo, AppPreference.DirectPlayDoviProfile7, AppPreference.DecodeAv1))),
+                ),
+                group(
+                    R.string.orca_settings_subtitles,
+                    AppPreference.SubtitleStyle,
+                    conditional = listOf(ConditionalPreferences(usesExoPlayer, listOf(AppPreference.AssSubtitleMode, AppPreference.DirectPlayPgs))),
+                ),
+            ).filter { it.preferences.isNotEmpty() || it.conditionalPreferences.isNotEmpty() }
+
+        OrcaSection.PLAYER ->
+            listOf(
+                group(
+                    R.string.player_backend,
+                    AppPreference.PlayerBackendPref,
+                    conditional =
+                        listOf(
+                            ConditionalPreferences(usesExoPlayer, listOf(AppPreference.FfmpegPreference)),
+                            ConditionalPreferences(
+                                { it.playbackPreferences.playerBackend.let { b -> b == PlayerBackend.MPV || b == PlayerBackend.PREFER_MPV } },
+                                listOf(AppPreference.MpvHardwareDecoding, AppPreference.MpvGpuNext, AppPreference.MpvConfFile),
+                            ),
+                            ConditionalPreferences(
+                                { it.playbackPreferences.playerBackend == PlayerBackend.EXTERNAL_PLAYER },
+                                listOf(AppPreference.ExternalPlayerApp),
+                            ),
+                        ),
+                ),
+                group(R.string.orca_settings_diagnostics, AppPreference.PlaybackDebugInfo),
+            )
+
+        OrcaSection.APPEARANCE ->
+            listOf(
+                group(R.string.orca_settings_look, AppPreference.ThemeColors, AppPreference.ShowLogos, AppPreference.BackdropStylePref, AppPreference.ShowClock),
+                group(
+                    R.string.orca_settings_home_menus,
+                    AppPreference.CustomizeHome,
+                    AppPreference.UserPinnedNavDrawerItems,
+                    AppPreference.RememberSelectedTab,
+                    AppPreference.DisplayTogglesPref,
+                    AppPreference.ManageMedia,
+                ),
+                group(R.string.orca_settings_extras, AppPreference.PlayThemeMusic, AppPreference.SlideshowDuration, AppPreference.SlideshowPlayVideos),
+            )
+
+        OrcaSection.PROFILE ->
+            listOf(
+                group(R.string.profile_specific_settings, AppPreference.ProtectProfilePreference, AppPreference.UserInterfaceLanguage, AppPreference.UserProfileSettings),
+                PreferenceGroup(
+                    R.string.orca_settings_signin,
+                    buildList {
+                        add(AppPreference.SignInAuto)
+                        add(AppPreference.QuickConnect)
+                        if (BuildConfig.DISCOVER_ENABLED) add(AppPreference.SeerrIntegration)
+                    },
+                ),
+            )
+
+        OrcaSection.SCREENSAVER ->
+            listOf(
+                group(
+                    R.string.screensaver,
+                    ScreensaverPreference.Enabled,
+                    ScreensaverPreference.StartDelay,
+                    ScreensaverPreference.Duration,
+                    ScreensaverPreference.ShowClock,
+                    ScreensaverPreference.Animate,
+                    ScreensaverPreference.MaxAge,
+                    ScreensaverPreference.ItemTypes,
+                    ScreensaverPreference.Start,
+                ),
+                group(R.string.dim_screen, ScreensaverPreference.DimToggle, ScreensaverPreference.DimPercentage),
+            )
+
+        // The Orca+ entry is drawn on its own by PreferencesContent (orcaEntry)
+        OrcaSection.ORCA -> listOf()
+
+        OrcaSection.ABOUT ->
+            listOf(
+                PreferenceGroup(
+                    R.string.about,
+                    buildList {
+                        add(AppPreference.InstalledVersion)
+                        if (UpdateChecker.ACTIVE) {
+                            add(AppPreference.Update)
+                            add(AppPreference.AutoCheckForUpdates)
+                            add(AppPreference.UpdateUrl)
+                        }
+                        add(AppPreference.OssLicenseInfo)
+                    },
+                ),
+                group(
+                    R.string.orca_settings_help,
+                    AppPreference.SendAppLogs,
+                    AppPreference.SendCrashReports,
+                    AppPreference.DebugLogging,
+                    AppPreference.ImageDiskCacheSize,
+                    AppPreference.ClearImageCache,
+                    ExperimentalPreference.Enable,
+                    conditional = listOf(ConditionalPreferences({ it.experimentalPreferences.enabled }, listOf(ExperimentalPreference.ExperimentalSettings))),
+                ),
+            )
+    }
+
+/**
+ * Settings as two panes: topics on the left; the focused topic's settings on the right. Moving
+ * through the topics previews each one; Right (or OK) goes into it, Back comes out to the topics.
+ */
+@OptIn(androidx.compose.ui.ExperimentalComposeUiApi::class)
+@Composable
+fun OrcaSettingsPage(
+    initialPreferences: AppPreferences,
+    modifier: Modifier = Modifier,
+) {
+    var section by rememberSaveable { mutableStateOf(OrcaSection.PLAYBACK) }
+    var focused by remember { mutableStateOf(OrcaSection.PLAYBACK) }
+    var inPane by remember { mutableStateOf(false) }
+    val railFocus = remember { OrcaSection.entries.associateWith { FocusRequester() } }
+    // Entering a topic (Right or OK from the list) lands on its first setting, not on whichever
+    // setting happens to sit level with the topic
+    val paneFocus = remember(section) { FocusRequester() }
+
+    // Follow the focused topic once it rests, so sweeping down the list doesn't rebuild every pane
+    LaunchedEffect(focused) {
+        if (focused != section) {
+            delay(140)
+            section = focused
+        }
+    }
+    LaunchedEffect(Unit) { runCatching { railFocus.getValue(section).requestFocus() } }
+
+    val backToRail = {
+        inPane = false
+        runCatching { railFocus.getValue(section).requestFocus() }
+        Unit
+    }
+    // Back inside a topic returns to the topic list (key route for Android 11, callback for 13+)
+    BackHandler(enabled = inPane) { backToRail() }
+
+    Row(modifier.fillMaxSize().background(MaterialTheme.colorScheme.background)) {
+        Column(
+            Modifier.width(340.dp).fillMaxHeight().padding(start = 40.dp, end = 20.dp, top = 28.dp),
+            verticalArrangement = Arrangement.spacedBy(4.dp),
+        ) {
+            Text(stringResource(R.string.settings), style = MaterialTheme.typography.headlineMedium, fontWeight = FontWeight.Bold, color = MaterialTheme.colorScheme.onBackground)
+            Spacer(Modifier.height(10.dp))
+            // Sized so all nine topics fit on a 1080p TV without scrolling
+            LazyColumn(verticalArrangement = Arrangement.spacedBy(3.dp)) {
+                itemsIndexed(OrcaSection.entries) { _, s ->
+                    RailItem(
+                        s,
+                        selected = s == section,
+                        modifier =
+                            Modifier.focusRequester(railFocus.getValue(s)).onFocusChanged {
+                                if (it.isFocused) {
+                                    focused = s
+                                    inPane = false
+                                }
+                            },
+                        onClick = {
+                            section = s
+                            focused = s
+                        },
+                    )
+                }
+            }
+        }
+        Box(
+            Modifier
+                .weight(1f)
+                .fillMaxHeight()
+                .focusProperties { enter = { paneFocus } }
+            .onFocusChanged { if (it.hasFocus) inPane = true }
+                .onPreviewKeyEvent { e ->
+                    if (inPane && (e.key == Key.Back || e.key == Key.Escape)) {
+                        if (e.type == KeyEventType.KeyUp) backToRail()
+                        true
+                    } else {
+                        false
+                    }
+                },
+        ) {
+            key(section) {
+                PreferencesContent(
+                    initialPreferences,
+                    PreferenceScreenOption.BASIC,
+                    Modifier.fillMaxSize(),
+                    groupsOverride = orcaGroups(section),
+                    titleOverride = stringResource(section.title),
+                    grabFocus = false,
+                    animateIn = false,
+                    orcaEntry = section == OrcaSection.ORCA,
+                    entryFocusRequester = paneFocus,
+                )
+            }
+        }
+    }
+}
+
+@Composable
+private fun RailItem(
+    section: OrcaSection,
+    selected: Boolean,
+    modifier: Modifier,
+    onClick: () -> Unit,
+) {
+    Surface(
+        onClick = onClick,
+        shape = ClickableSurfaceDefaults.shape(RoundedCornerShape(8.dp)),
+        colors =
+            ClickableSurfaceDefaults.colors(
+                containerColor = if (selected) MaterialTheme.colorScheme.surfaceVariant else androidx.compose.ui.graphics.Color.Transparent,
+                contentColor = MaterialTheme.colorScheme.onSurface,
+                focusedContainerColor = MaterialTheme.colorScheme.inverseSurface,
+                focusedContentColor = MaterialTheme.colorScheme.inverseOnSurface,
+            ),
+        scale = ClickableSurfaceDefaults.scale(focusedScale = 1.02f),
+        modifier = modifier.fillMaxWidth(),
+    ) {
+        Column(Modifier.padding(horizontal = 14.dp, vertical = 6.dp)) {
+            Text(stringResource(section.title), fontSize = 15.sp, fontWeight = FontWeight.SemiBold, maxLines = 1)
+            Text(stringResource(section.hint), fontSize = 11.sp, maxLines = 1, overflow = androidx.compose.ui.text.style.TextOverflow.Ellipsis)
+        }
+    }
+}
