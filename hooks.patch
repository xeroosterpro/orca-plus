+/**
+ * Every setting, in the topic people would look for it under. Orca+'s own items (home style, rows,
+ * poster tags, lists, extra servers, search, cloud sync, credits) sit at the top of their topic,
+ * drawn by the addon ([com.wholphinplus.sources.ui.OrcaTopicItems]). With the Cinema home on, the
+ * two settings it replaces are left out: the app theme (Cinema has its own look) and Customize
+ * home (Rows does that).
+ */
+fun orcaGroups(
+    section: OrcaSection,
+    cinema: Boolean = false,
+): List<PreferenceGroup<AppPreferences>> =
+    when (section) {
+        // A topic page (2026-10-12 layout, owner approved): what's used most as rows that open a
+        // page and say where they stand, the clock as a switch; Ask before closing (Orca+) last
+        OrcaSection.PLAYBACK ->
+            listOf(
+                group(
+                    0,
+                    page(R.string.orca_page_skip, "PLAYBACK_SKIP", summary("Intros" to AppPreference.SkipIntros, "Credits" to AppPreference.SkipOutros)),
+                    page(R.string.orca_page_nextup, "PLAYBACK_NEXTUP", summary(null to AppPreference.ShowNextUpTiming, "Autoplay" to AppPreference.AutoPlayNextUp)),
+                    page(R.string.orca_page_remote, "PLAYBACK_REMOTE", summary("Skip forward" to AppPreference.SkipForward, "Back" to AppPreference.SkipBack)),
+                    page(R.string.orca_page_card, "PLAYBACK_CARD", { ctx, _ -> ctx.getString(R.string.orca_page_card_summary) }),
+                    page(R.string.orca_page_picture, "PLAYBACK_PICTURE", summary(null to AppPreference.GlobalContentScale)),
+                    AppPreference.ShowClock,
+                ),
+            )
+
+        // Orca+ items only (every key and service: KeysAndServices), then requests
+        OrcaSection.KEYS ->
+            if (BuildConfig.DISCOVER_ENABLED) listOf(group(R.string.orca_settings_requests, AppPreference.SeerrIntegration)) else emptyList()
+
+        // Everyday first (languages, subtitle style, quality); codecs, decoders and diagnostics on
+        // the Advanced page
+        OrcaSection.QUALITY ->
+            listOf(
+                group(
+                    0,
+                    page(R.string.orca_page_languages, "QUALITY_LANGUAGES", { ctx, _ -> ctx.getString(R.string.override_user_profile_settings_summary) }),
+                    AppPreference.SubtitleStyle,
+                    page(R.string.orca_page_streaming, "QUALITY_STREAMING", summary("Max " to AppPreference.MaxBitrate)),
+                    page(R.string.orca_page_advanced, "QUALITY_ADVANCED", summary(null to AppPreference.PlayerBackendPref)),
+                ),
+            )
+
+        // Home & Look is Orca+'s own items only (ExtraSourcesSettings). Wholphin's look settings
+        // (app theme, title logos, backdrop style, nav drawer, tabs, ratings display, media
+        // management, theme music, photo slideshows) only changed its classic screens, which
+        // Orca+ no longer shows (one look since 2026-10-07). The clock is the player's: Playback.
+        OrcaSection.APPEARANCE -> emptyList()
+
+        // Orca+ items only: extra servers, choosing a copy (requests moved to Keys & Services)
+        OrcaSection.SOURCES -> emptyList()
+
+        // Orca+ account card first, then signing in and this profile
+        OrcaSection.ACCOUNT ->
+            listOf(
+                group(R.string.orca_settings_signin, AppPreference.SignInAuto, AppPreference.QuickConnect),
+                group(R.string.orca_settings_your_profile, AppPreference.ProtectProfilePreference),
+            )
+
+        // Orca+ device card and performance first, then what belongs to the box
+        // Orca+ device card and performance first, then the box's language, screensaver and storage
+        OrcaSection.DEVICE ->
+            listOf(
+                group(
+                    0,
+                    AppPreference.UserInterfaceLanguage,
+                    page(R.string.orca_page_screensaver, "DEVICE_SCREENSAVER", screensaverSummary),
+                    page(R.string.orca_page_storage, "DEVICE_STORAGE", summary(null to AppPreference.ImageDiskCacheSize)),
+                ),
+            )
+
+        OrcaSection.ABOUT ->
+            listOf(
+                PreferenceGroup(
+                    R.string.about,
+                    buildList {
+                        add(AppPreference.InstalledVersion)
+                        if (UpdateChecker.ACTIVE) {
+                            add(AppPreference.Update)
+                            add(AppPreference.AutoCheckForUpdates)
+                            add(AppPreference.UpdateUrl)
+                        }
+                        add(AppPreference.OssLicenseInfo)
+                        add(page(R.string.orca_page_help, "ABOUT_HELP", { ctx, _ -> ctx.getString(R.string.orca_page_help_summary) }))
+                    },
+                ),
+            )
+    }
