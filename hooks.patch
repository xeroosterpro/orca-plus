+/** Pages whose rows are Orca+'s own (drawn by the addon's OrcaTopicItems under this name). */
+private val orcaPageItems = setOf("PLAYBACK_CARD")
+
+private fun page(
+    @StringRes title: Int,
+    id: String,
+    summaryOf: (android.content.Context, AppPreferences) -> String?,
+) = com.github.damontecres.wholphin.preferences.AppSubPagePreference<AppPreferences>(title, id, summaryOf)
+
+/** A setting's value as its row shows it: a choice's label, a slider's or switch's own words. */
+@Suppress("UNCHECKED_CAST")
+private fun valueText(
+    context: android.content.Context,
+    pref: AppPreference<AppPreferences, *>,
+    prefs: AppPreferences,
+): String? =
+    runCatching {
+        when (pref) {
+            is com.github.damontecres.wholphin.preferences.AppChoicePreference<AppPreferences, *> -> {
+                val p = pref as com.github.damontecres.wholphin.preferences.AppChoicePreference<AppPreferences, Any?>
+                context.resources.getStringArray(p.displayValues).getOrNull(p.valueToIndex(p.getter(prefs)))
+            }
+            is com.github.damontecres.wholphin.preferences.AppSwitchPreference<AppPreferences> ->
+                pref.summary(context, pref.getter(prefs)) ?: context.getString(if (pref.getter(prefs)) R.string.orca_on else R.string.orca_off)
+            else -> (pref as AppPreference<AppPreferences, Any?>).let { it.summary(context, it.getter(prefs)) }
+        }
+    }.getOrNull()
+
+/** "Intros: Ask to skip · Credits: Ask to skip": each part's label (if any) and value. */
+private fun summary(vararg parts: Pair<String?, AppPreference<AppPreferences, *>>): (android.content.Context, AppPreferences) -> String? =
+    { context, prefs ->
+        // A label ending in a space reads straight on ("Max 200 Mbps"); others take a colon
+        parts.mapNotNull { (label, pref) -> valueText(context, pref, prefs)?.let { v -> label?.let { if (it.endsWith(" ")) "$it$v" else "$it: $v" } ?: v } }.joinToString("  ·  ").ifBlank { null }
+    }
+
+private val screensaverSummary: (android.content.Context, AppPreferences) -> String? = { context, prefs ->
+    if (!ScreensaverPreference.Enabled.getter(prefs)) {
+        context.getString(R.string.orca_off)
+    } else {
+        summary("After " to ScreensaverPreference.StartDelay, null to ScreensaverPreference.Duration)(context, prefs)
+    }
+}
