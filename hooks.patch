+package com.github.damontecres.wholphin.ui.setup
+
+import android.Manifest
+import android.os.Build
+import androidx.activity.compose.rememberLauncherForActivityResult
+import androidx.activity.result.contract.ActivityResultContracts
+import androidx.compose.foundation.background
+import androidx.compose.foundation.layout.Box
+import androidx.compose.foundation.layout.fillMaxSize
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.LaunchedEffect
+import androidx.compose.runtime.collectAsState
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.rememberCoroutineScope
+import androidx.compose.runtime.saveable.rememberSaveable
+import androidx.compose.runtime.setValue
+import kotlinx.coroutines.launch
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.platform.LocalContext
+import androidx.hilt.lifecycle.viewmodel.compose.hiltViewModel
+import com.github.damontecres.wholphin.data.model.JellyfinServer
+import com.github.damontecres.wholphin.services.SetupDestination
+import com.github.damontecres.wholphin.util.LoadingState
+import com.wholphinplus.sources.SourceHook
+import com.wholphinplus.sources.ui.SourcesEntryPoint
+import com.wholphinplus.sources.welcome.FoundServer
+import com.wholphinplus.sources.welcome.Onboarding
+import com.wholphinplus.sources.welcome.SavedServer
+import com.wholphinplus.sources.welcome.WelcomeFinish
+import com.wholphinplus.sources.welcome.WelcomeServerChoice
+import com.wholphinplus.sources.welcome.WelcomeServerFlow
+import com.wholphinplus.sources.welcome.WelcomeSignIn
+import com.wholphinplus.sources.welcome.WelcomeUser
+import dagger.hilt.android.EntryPointAccessors
+import org.jellyfin.sdk.api.client.extensions.quickConnectApi
+import org.jellyfin.sdk.api.client.extensions.userApi
+import org.jellyfin.sdk.model.serializer.toUUIDOrNull
+
+/*
+ * Orca+: the first-run welcome. The screens live in the addon (welcome/); this file connects them
+ * to Wholphin's own server and sign-in logic, so adding a server and signing in work exactly as
+ * in Wholphin. The first run gets the whole welcome; signing in again later (the sign-in ran out,
+ * or "Change server") gets the same look: saved servers, then the sign-in.
+ */
+
+@Composable
+private fun orcaHook(): SourceHook {
+    val context = LocalContext.current
+    return remember { EntryPointAccessors.fromApplication(context.applicationContext, SourcesEntryPoint::class.java).sourceHook() }
+}
+
+/** In place of Wholphin's server list: the welcome on a true first run, else Wholphin's list. */
+@Composable
+fun OrcaServerList(modifier: Modifier = Modifier) {
+    val hook = orcaHook()
+    val stage by hook.store.onboarding.collectAsState()
+    val viewModel: SwitchServerViewModel = hiltViewModel()
+    val state by viewModel.state.collectAsState()
+    LaunchedEffect(Unit) { viewModel.init() }
+
+    val firstRun = stage == Onboarding.STARTED || (stage == Onboarding.NEW && state.loading is LoadingState.Success && state.servers.isEmpty())
+    // Signing in again: "Add a server" opens the welcome's server step
+    var adding by rememberSaveable { mutableStateOf(false) }
+    // Orca+: "I have an Orca+ account" from the saved servers (after signing out): the whole welcome,
+    // so the name and PIN bring the setup back as on a new TV
+    var account by rememberSaveable { mutableStateOf(false) }
+    when {
+        firstRun || adding || account -> {
+            LaunchedEffect(Unit) { if (hook.store.onboarding.value == Onboarding.NEW || account) hook.store.setOnboarding(Onboarding.STARTED) }
+            val permission =
+                rememberLauncherForActivityResult(ActivityResultContracts.RequestPermission()) { granted ->
+                    if (granted) viewModel.discoverServers()
+                }
+            LaunchedEffect(Unit) {
+                viewModel.clearAddServerState()
+                if (viewModel.hasPermission) {
+                    viewModel.discoverServers()
+                } else if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.CINNAMON_BUN) {
+                    permission.launch(Manifest.permission.ACCESS_LOCAL_NETWORK)
+                }
+            }
+            val found = state.discoveredServers.map { FoundServer(it.id.toString(), it.name.orEmpty(), it.url) }
+            // Set up from a phone: its server is added as if typed here; a server that can't be
+            // reached goes back to the phone to fix
+            val phone by com.wholphinplus.sources.welcome.PhoneSetup.details.collectAsState()
+            LaunchedEffect(phone?.attempt) {
+                val d = phone ?: return@LaunchedEffect
+                if (com.wholphinplus.sources.welcome.PhoneSetup.claimServer(d.attempt)) {
+                    viewModel.clearAddServerState()
+                    viewModel.addServer(d.server, false)
+                }
+            }
+            LaunchedEffect(state.addServerState) {
+                val e = state.addServerState as? LoadingState.Error ?: return@LaunchedEffect
+                if (com.wholphinplus.sources.welcome.PhoneSetup.phase.value == com.wholphinplus.sources.welcome.PhoneSetup.Phase.CONNECTING) {
+                    com.wholphinplus.sources.welcome.PhoneSetup.fail("Couldn't reach ${phone?.server}${e.localizedMessage?.let { ": $it" }.orEmpty()}")
+                }
+            }
+            WelcomeServerFlow(
+                found = found,
+                connecting = state.addServerState is LoadingState.Loading,
+                error = (state.addServerState as? LoadingState.Error)?.localizedMessage,
+                onPick = { picked -> state.discoveredServers.firstOrNull { it.id.toString() == picked.key }?.let(viewModel::switchServer) },
+                onAddress = { viewModel.addServer(it, false) },
+                onSearchAgain = { viewModel.discoverServers() },
+                modifier = modifier,
+                // Signing in again: straight to the server step; Back returns to the server list
+                startAtServer = adding && !account,
+                onBack = {
+                    adding = false
+                    account = false
+                },
+                onCloudSignIn = { login -> orcaCloudSignIn(viewModel, login) },
+            )
+        }
+        // Still finding out whether servers are saved: a dark stage, not a flash of the old list
+        stage == Onboarding.NEW && state.loading !is LoadingState.Success && state.loading !is LoadingState.Error ->
+            Box(modifier.fillMaxSize().background(Color(0xFF0B0B0B)))
+        else ->
+            WelcomeServerChoice(
+                servers =
+                    state.servers.map {
+                        SavedServer(
+                            key = it.server.id.toString(),
+                            name = it.server.name.orEmpty(),
+                            address = it.server.url,
+                            reachable =
+                                when (it.status) {
+                                    is ServerConnectionStatus.Success -> true
+                                    is ServerConnectionStatus.Error -> false
+                                    else -> null
+                                },
+                        )
+                    },
+                onPick = { picked ->
+                    state.servers.firstOrNull { it.server.id.toString() == picked.key }?.let {
+                        if (it.status is ServerConnectionStatus.Success) viewModel.switchServer(it.server) else viewModel.testServer(it.server)
+                    }
+                },
+                onAdd = { adding = true },
+                modifier = modifier,
+                onAccount = { account = true },
+            )
+    }
+}
+
+/**
+ * Orca+ name sign-in: Wholphin signs in with the main server sign-in the cloud profile holds.
+ * The TV gets a token of its own by approving its own Quick Connect request with the saved one
+ * (the saved one stays the other TV's); a server without Quick Connect uses the saved token.
+ * Throws with words for the screen.
+ */
+private suspend fun orcaCloudSignIn(
+    viewModel: SwitchServerViewModel,
+    login: com.wholphinplus.sources.sync.MainLogin,
+) = kotlinx.coroutines.withContext(kotlinx.coroutines.Dispatchers.IO) {
+    val serverId = login.serverId.toUUIDOrNull() ?: error("Your setup's server sign-in is damaged. Sign in with your server instead.")
+    val userId = login.userId.toUUIDOrNull() ?: error("Your setup's server sign-in is damaged. Sign in with your server instead.")
+    val saved = viewModel.jellyfin.createApi(baseUrl = login.url, accessToken = login.token)
+    val me =
+        try {
+            saved.userApi.getCurrentUser().content
+        } catch (e: org.jellyfin.sdk.api.client.exception.InvalidStatusException) {
+            if (e.status == 401 || e.status == 403) error("Your saved server sign-in has run out. Sign in with your server instead; Orca+ then saves a fresh one.")
+            throw e
+        } catch (e: org.jellyfin.sdk.api.client.exception.ApiClientException) {
+            error("Couldn't reach your server at ${login.url}. Check this TV's internet, or sign in with your server instead.")
+        }
+    val own =
+        try {
+            val api = viewModel.jellyfin.createApi(baseUrl = login.url)
+            val qc = api.quickConnectApi.initiateQuickConnect().content
+            saved.quickConnectApi.authorizeQuickConnect(code = qc.code, userId = userId)
+            api.userApi.authenticateWithQuickConnect(org.jellyfin.sdk.model.api.QuickConnectDto(secret = qc.secret)).content
+        } catch (e: kotlinx.coroutines.CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            timber.log.Timber.i(e, "Orca+ name sign-in: no Quick Connect, using the saved sign-in")
+            null
+        }
+    val current =
+        if (own != null) {
+            viewModel.serverRepository.changeUser(login.url, own, null)
+        } else {
+            viewModel.serverRepository.changeUser(
+                JellyfinServer(serverId, null, login.url, null),
+                com.github.damontecres.wholphin.data.model.JellyfinUser(id = userId, name = me.name ?: login.userName, serverId = serverId, accessToken = login.token),
+            )
+        }
+    viewModel.navigationManager.navigateTo(SetupDestination.AppContent(current))
+}
+
+/** In place of Wholphin's user list: the welcome's sign-in during the first run. */
+@Composable
+fun OrcaUserList(
+    server: JellyfinServer,
+    modifier: Modifier = Modifier,
+) {
+    val hook = orcaHook()
+    val stage by hook.store.onboarding.collectAsState()
+    val viewModel = hiltViewModel<SwitchUserViewModel, SwitchUserViewModel.Factory>(creationCallback = { it.create(server) })
+    val state by viewModel.state.collectAsState()
+    // Users with a Wholphin PIN on this TV keep Wholphin's own screen (it asks for the PIN)
+    if (stage != Onboarding.STARTED && state.users.any { it.known && it.user.pin != null }) {
+        SwitchUserContent(server = server, modifier)
+        return
+    }
+    val scope = rememberCoroutineScope()
+    var submitted by remember { mutableStateOf(false) }
+    var switchError by remember { mutableStateOf<String?>(null) }
+    LaunchedEffect(Unit) { viewModel.init() }
+    val error = switchError ?: (state.switchUserState as? LoadingState.Error)?.localizedMessage
+    LaunchedEffect(error) { if (error != null) submitted = false }
+    // Set up from a phone: its username and password, or (another server sent) back to the servers
+    val phoneSetup = com.wholphinplus.sources.welcome.PhoneSetup
+    val phone by phoneSetup.details.collectAsState()
+    LaunchedEffect(phone?.attempt) {
+        val d = phone ?: return@LaunchedEffect
+        if (!phoneSetup.sameServer(d.server, server.url)) {
+            viewModel.setupNavigationManager.navigateTo(SetupDestination.ServerList)
+            return@LaunchedEffect
+        }
+        if (phoneSetup.claimLogin(d.attempt)) {
+            switchError = null
+            submitted = true
+            viewModel.clearSwitchUserState()
+            viewModel.login(server, null, d.username, d.password)
+        }
+    }
+    LaunchedEffect(error) {
+        if (error != null && phoneSetup.phase.value == com.wholphinplus.sources.welcome.PhoneSetup.Phase.SIGNING_IN) phoneSetup.fail(phoneSetup.loginProblem(error))
+    }
+    WelcomeSignIn(
+        eyebrow = if (stage == Onboarding.STARTED) "SIGN IN  ·  2 OF 2" else "SIGN IN",
+        // Someone already signed in on this TV switches straight in; if that sign-in has run
+        // out, the password box is waiting
+        onPickUser = { name ->
+            switchError = null
+            state.users.firstOrNull { it.known && it.user.name == name && it.user.accessToken != null }?.let { u ->
+                scope.launch {
+                    val r = viewModel.trySwitchUser(u.user).await()
+                    if (r is SwitchUserResult.Error) switchError = r.errorMessage
+                }
+            }
+        },
+        serverName = server.name.orEmpty(),
+        quickEnabled = state.quickConnectEnabled,
+        quickCode = state.quickConnectStatus?.code,
+        users = state.users.map { WelcomeUser(it.user.name.orEmpty(), it.imageUrl) }.filter { it.name.isNotBlank() },
+        busy = submitted,
+        error = error,
+        onQuickConnect = { viewModel.initiateQuickConnect(server, null) },
+        onPassword = { user, password ->
+            switchError = null
+            submitted = true
+            viewModel.clearSwitchUserState()
+            viewModel.login(server, null, user, password)
+        },
+        onBack = {
+            viewModel.cancelQuickConnect()
+            viewModel.setupNavigationManager.navigateTo(SetupDestination.ServerList)
+        },
+        modifier = modifier,
+    )
+}
+
+/**
+ * True while the welcome's last steps (other libraries, the look) own the screen after sign-in.
+ * MainContent shows [OrcaWelcomeFinish] instead of the app until then.
+ */
+@Composable
+fun orcaWelcomeOwnsScreen(): Boolean {
+    val hook = orcaHook()
+    val stage by hook.store.onboarding.collectAsState()
+    LaunchedEffect(stage) { if (stage == Onboarding.STARTED) hook.store.setOnboarding(Onboarding.FINISHING) }
+    return stage == Onboarding.STARTED || stage == Onboarding.FINISHING
+}
+
+@Composable
+fun OrcaWelcomeFinish(modifier: Modifier = Modifier) {
+    WelcomeFinish(onDone = {}, modifier = modifier.fillMaxSize())
+}
